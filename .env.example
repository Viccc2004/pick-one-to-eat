# Copy to .env and fill in real values. Never commit .env.

# Google Places API (New) — used from M3.
# Restrict this key to Places API (New) in the console. Quotas there are
# not adjustable; the daily spend cap lives in cache.py instead.
GOOGLE_PLACES_API_KEY=

# Anthropic API — used from M4.
ANTHROPIC_API_KEY=
