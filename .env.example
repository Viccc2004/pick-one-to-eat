# Copy to .env and fill in real values. Never commit .env.

# Google Places API (New) — used from M3.
# Restrict this key to Places API (New) in the console. Quotas there are
# not adjustable; the daily spend cap lives in cache.py instead.
GOOGLE_PLACES_API_KEY=

# Gemini API — used from M4. Create it in AI Studio in a SEPARATE project
# with no billing account linked, so it stays on the free tier. A key made
# in the billing-linked Places project could bill as paid tier.
GEMINI_API_KEY=
